@page
@model IndexModel

@{
    ViewData["Title"] = User.Identity?.IsAuthenticated == true
        ? "Dashboard"
        : "Welcome to StudyFlow";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <main class="dashboard">

        <h1>
            <span class="tape-heading">Dashboard</span>
        </h1>

        <div class="dashboard-book">

            @* Left page. *@
            <section class="dashboard-book-page">

                @* Today's focus. *@
                <section class="tasks-board-section todays-focus-section">
                    <h2 class="board-note-heading">
                        Today's focus
                    </h2>

                    @if (Model.TodaysFocus != null)
                    {
                        <ul class="board-task-list focus-task-list">
                            <partial name="_TaskCard"
                                     model="Model.TodaysFocus.Task" />
                        </ul>
                    }
                    else
                    {
                        <p class="board-empty-message">
                            No tasks to prioritize right now.
                        </p>
                    }
                </section>

                @* Completed tasks summary. *@
                <section class="dashboard-completed">
                    <h2>All the small things</h2>
                    <a asp-page="/Tasks/Index"
                        asp-fragment="completed-tasks"
                        class="completed-tasks-note">
                        <p class="completed-tasks-icons">
                            ⭐️ 🏆 ⭐️
                        </p>
                        <p class="completed-tasks-count">
                            You have completed @Model.CompletedTaskCount tasks! 
                        </p>
                        <p class="completed-tasks-message">
                            Well done!
                        </p>
                    </a>
                </section>

            </section>

            @* Right page. *@
            <section class="dashboard-book-page">

                @* Coming up. *@
                <section class="tasks-board-section coming-up-section">
                    <h2 class="board-note-heading">
                        Coming up
                    </h2>

                    @if (Model.ComingUp.Any())
                    {
                        <ul class="board-task-list">
                            @foreach (var task in Model.ComingUp.Take(4))
                            {
                                <partial name="_TaskCardCompact"
                                         model="task" />
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="board-empty-message">
                            No upcoming tasks.
                        </p>
                    }

                    <a asp-page="/Tasks/Index" class="dashboard-tasks-link">
                        Show all tasks →
                    </a>
                </section>

                @* Course overview. *@
                <section class="dashboard-courses">
                    <h2>My little study corner</h2>

                    @if (Model.Courses.Any())
                    {
                        <ul class="dashboard-course-list">
                            @foreach (var course in Model.Courses.Take(2))
                            {
                                <partial name="_CourseCard" model="course" />
                            }
                        </ul>
                    }
                    else
                    {
                        <p>You haven't added any courses yet.</p>
                    }

                    <a asp-page="/Courses/Index" class="dashboard-courses-link">
                        Show all courses →
                    </a>
                </section>

            </section>

        </div>

    </main>
}
else
{
    <main class="welcome-page">

        <h1>Welcome to StudyFlow!</h1>

        <p>
            Plan your studies, organize your tasks
            and keep track of your progress – all in one place.
        </p>

        <div class="welcome-actions">
            <a asp-area="Identity"
               asp-page="/Account/Login">
                Log in
            </a>

            <a asp-area="Identity"
               asp-page="/Account/Register">
                Create account
            </a>
        </div>

    </main>
}

@if (User.Identity?.IsAuthenticated == true)
{
    @if (Model.TodaysFocus != null)
    {
        var task = Model.TodaysFocus.Task;

        <partial name="_TaskDetailsDialog" model="task" />
        <partial name="_EditTaskDialog" model="task" />
        <partial name="_DeleteTaskDialog" model="task" />
    }

    @foreach (var task in Model.ComingUp.Take(4)
        .Where(task => task.Id != Model.TodaysFocus?.Task.Id))
    {
        <partial name="_TaskDetailsDialog" model="task" />
        <partial name="_EditTaskDialog" model="task" />
        <partial name="_DeleteTaskDialog" model="task" />
    }
}

@section Scripts {
    <script src="~/js/task-form-validation.js"
            asp-append-version="true"></script>
    <script src="~/js/tasks.js"
            asp-append-version="true"></script>
}