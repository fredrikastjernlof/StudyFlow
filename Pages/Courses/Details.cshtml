@page "{id:int}"
@model StudyFlow.Pages.Courses.DetailsModel

@{
    ViewData["Title"] = Model.Course.Name;
}

<main>
    <a asp-page="./Index">← Tillbaka till mina kurser</a>

    <header>
        <h1>@Model.Course.Name</h1>
    </header>

    <button type="button" id="openEditCourseDialog">
        Redigera kurs
    </button>

    <dialog id="editCourseDialog" aria-labelledby="editCourseDialogTitle">
        <h2 id="editCourseDialogTitle">Redigera kurs</h2>

        <form method="post" asp-page-handler="Edit" novalidate>
            <div>
                <label asp-for="CourseName">Kursnamn</label>
                <input asp-for="CourseName" maxlength="100" />
                <span asp-validation-for="CourseName" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="CourseColor">Kursfärg</label>
                <input asp-for="CourseColor" type="color" />
                <span asp-validation-for="CourseColor" class="text-danger"></span>
            </div>

            <button type="submit">Spara ändringar</button>
            <button type="button" id="closeEditCourseDialog">Avbryt</button>
            <button type="button" id="openDeleteCourseDialog">Ta bort kurs</button>
        </form>
    </dialog>

    <dialog id="deleteCourseDialog" aria-labelledby="deleteCourseDialogTitle"
            aria-describedby="deleteCourseDialogDescription">

        <h2 id="deleteCourseDialogTitle">Ta bort kurs?</h2>

        <p id="deleteCourseDialogDescription">
            Är du säker på att du vill ta bort kursen
            <strong>@Model.Course.Name</strong>?
            Alla uppgifter och checklistor som tillhör kursen
            kommer också att raderas permanent.
        </p>

        <form method="post" asp-page-handler="Delete">
            <button type="button" id="closeDeleteCourseDialog">
                Avbryt
            </button>

            <button type="submit">
                Ja, ta bort kurs
            </button>
        </form>
    </dialog>

    <section aria-labelledby="tasks-heading">
        <h2 id="tasks-heading">Uppgifter</h2>

        @if (Model.Tasks.Any())
        {
            <ul>
                @foreach (var task in Model.Tasks)
                {
                    <li>
                        <h3>
                            <button type="button" class="task-details-button" data-task-id="@task.Id">
                                @task.Title
                            </button>
                        </h3>

                        <p class="task-course-name">@Model.Course.Name</p>

                        <p>Prioritet:
                            @(task.Priority == 3 ? "Hög" :
                              task.Priority == 2 ? "Medel" : "Låg")
                        </p>

                        @if (task.Deadline.HasValue)
                        {
                            <p>Deadline: @task.Deadline.Value.ToString("yyyy-MM-dd")</p>
                        }

                        @if (task.ChecklistItems.Any())
                        {
                            var completed = task.ChecklistItems.Count(item => item.IsCompleted);
                            var total = task.ChecklistItems.Count;

                            <div class="task-card-checklist">
                                <ul>
                                    @foreach (var item in task.ChecklistItems.OrderBy(item => item.IsCompleted).ThenBy(item =>
                        item.Id))
                                    {
                                        <li data-order="@item.Id">
                                            <label>
                                                <input type="checkbox" class="checklist-checkbox" data-item-id="@item.Id"
                                                       checked="@item.IsCompleted" />
                                                @item.Title
                                            </label>
                                        </li>
                                    }
                                </ul>

                                <p class="checklist-count">@completed/@total done</p>
                                <progress class="checklist-progress" value="@completed" max="@total">
                                </progress>
                            </div>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            <p>Inga uppgifter har lagts till i den här kursen ännu.</p>
        }
    </section>

    @foreach (var task in Model.Tasks)
    {
        var completedItems = task.ChecklistItems.Count(i => i.IsCompleted);
        var totalItems = task.ChecklistItems.Count;

        <dialog id="taskDialog-@task.Id" aria-labelledby="taskHeading-@task.Id">
            <h2 id="taskHeading-@task.Id">@task.Title</h2>
            <p>@task.Description</p>
            <p>Uppskattad arbetsinsats: @task.EstimatedHours timmar</p>

            <p>Prioritet:
                @(task.Priority == 3 ? "Hög" :
                  task.Priority == 2 ? "Medel" : "Låg")
            </p>

            <form method="post" asp-page-handler="UpdateTaskStatus" class="task-status-form">
                <input type="hidden" name="taskId" value="@task.Id" />
                <div class="validation-summary text-danger" role="alert" aria-live="polite" hidden></div>

                <div>
                    <label for="taskStatus-@task.Id">Status</label>

                    <select id="taskStatus-@task.Id" name="status" class="task-status-select">
                        <option value="NotStarted" selected="@(task.Status == "NotStarted")">
                            Ej påbörjad
                        </option>
                        <option value="InProgress" selected="@(task.Status == "InProgress")">
                            Pågående
                        </option>
                        <option value="Completed" selected="@(task.Status == "Completed")">
                            Avklarad
                        </option>
                    </select>
                </div>
            </form>

            @if (task.Deadline.HasValue)
            {
                <p>Deadline: @task.Deadline.Value.ToString("yyyy-MM-dd")</p>
            }

            <hr />

            <section aria-labelledby="checklistHeading-@task.Id">
                <h3 id="checklistHeading-@task.Id">Checklista</h3>

                @if (totalItems > 0)
                {
                    <ul>
                        @foreach (var item in task.ChecklistItems.OrderBy(i => i.IsCompleted).ThenBy(i => i.Id))
                        {
                            <li data-order="@item.Id">
                                <label>
                                    <input type="checkbox" class="checklist-checkbox" data-item-id="@item.Id"
                                           checked="@item.IsCompleted" />
                                    @item.Title
                                </label>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p>Inga delmoment har lagts till ännu.</p>
                }
            </section>

            <section aria-label="Checklistans framsteg">
                <div>
                    <strong>Making progress!</strong>
                    <span class="checklist-count">@completedItems/@totalItems done</span>
                </div>

                <progress class="checklist-progress" value="@completedItems" max="@(totalItems > 0 ? totalItems : 1)"
                          aria-label="Avklarade delmoment">
                </progress>
            </section>

            <button type="button" class="open-edit-task-dialog" data-task-id="@task.Id">
                Redigera
            </button>
            <button type="button" class="open-delete-task-dialog" data-task-id="@task.Id">Ta bort uppgift</button>
            <button type="button" class="close-task-dialog">
                Stäng
            </button>
        </dialog>
    }

    @foreach (var task in Model.Tasks)
    {
        <dialog id="deleteTaskDialog-@task.Id" aria-labelledby="deleteTaskHeading-@task.Id">
            <h2 id="deleteTaskHeading-@task.Id">Ta bort uppgift?</h2>
            <p>Är du säker på att du vill ta bort <strong>@task.Title</strong> och dess delmoment permanent?</p>
            <form method="post" asp-page-handler="DeleteTask">
                <input type="hidden" name="taskId" value="@task.Id" />
                <button type="button" class="cancel-delete-task">Avbryt</button>
                <button type="submit">Ja, ta bort uppgift</button>
            </form>
        </dialog>
    }

    @foreach (var task in Model.Tasks)
    {
        <dialog id="editTaskDialog-@task.Id" aria-labelledby="editTaskHeading-@task.Id">
            <h2 id="editTaskHeading-@task.Id">Redigera uppgift</h2>

            <form method="post" asp-page-handler="EditTask" class="edit-task-form" novalidate>
                <input type="hidden" name="taskId" value="@task.Id" />
                <div class="validation-summary text-danger" role="alert" aria-live="polite" hidden></div>

                <div>
                    <label for="editTitle-@task.Id">Uppgiftens namn</label>
                    <input id="editTitle-@task.Id" name="title" value="@task.Title" maxlength="100" />
                </div>

                <div>
                    <label for="editDescription-@task.Id">Beskrivning</label>
                    <textarea id="editDescription-@task.Id" name="description" rows="4" maxlength="1000">@task.Description</textarea>
                </div>

                <div>
                    <label for="editDeadline-@task.Id">Deadline</label>
                    <input id="editDeadline-@task.Id" name="deadline" type="date"
                           value="@(task.Deadline?.ToString("yyyy-MM-dd"))" />
                </div>

                <div>
                    <label for="editPriority-@task.Id">Prioritet</label>
                    <select id="editPriority-@task.Id" name="priority">
                        <option value="1" selected="@(task.Priority == 1)">Låg</option>
                        <option value="2" selected="@(task.Priority == 2)">Medel</option>
                        <option value="3" selected="@(task.Priority == 3)">Hög</option>
                    </select>
                </div>

                <div>
                    <label for="editHours-@task.Id">Uppskattad arbetsinsats (timmar)</label>
                    <input id="editHours-@task.Id" name="estimatedHours" type="number" min="0" max="1000" step="0.5"
                           value="@task.EstimatedHours" />
                </div>

                <section>
                    <h3>Redigera checklista</h3>

                    <div class="edit-checklist-items">
                        @foreach (var item in task.ChecklistItems.OrderBy(i => i.Id))
                        {
                            <button type="button" class="remove-checklist-row">
                                Ta bort
                            </button>
                            <div class="edit-checklist-row">
                                <input type="hidden" name="itemIds" value="@item.Id" />
                                <input type="text" name="itemTitles" value="@item.Title" maxlength="100" aria-label="Delmoment" />
                            </div>
                        }
                    </div>

                    <button type="button" class="add-checklist-row">
                        Lägg till delmoment
                    </button>
                </section>

                <button type="submit">Spara ändringar</button>
                <button type="button" class="close-edit-task-dialog">Avbryt</button>
            </form>
        </dialog>
    }

    <section aria-labelledby="add-task-heading">
        <h2 id="add-task-heading">Lägg till uppgift</h2>

        <form method="post" asp-page-handler="CreateTask" class="create-task-form" novalidate>
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Keys.Any(k => k.StartsWith("TaskInput.") || k == "checklistItems"))
            {
                <div class="validation-summary text-danger" role="alert" style="color:#b42318">
                    <strong>Kontrollera följande:</strong>
                    <ul>
                        @foreach (var error in ViewData.ModelState.Where(kvp => kvp.Key.StartsWith("TaskInput.") || kvp.Key == "checklistItems").SelectMany(kvp => kvp.Value!.Errors).Select(e => e.ErrorMessage).Distinct())
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <div class="validation-summary text-danger" role="alert" aria-live="polite" hidden></div>
            }
            <div>
                <label asp-for="TaskInput.Title">Uppgiftens namn</label>
                <input asp-for="TaskInput.Title" maxlength="100" placeholder="Ange uppgiftens namn" />
            </div>

            <div>
                <label asp-for="TaskInput.Description">Beskrivning</label>
                <textarea asp-for="TaskInput.Description" rows="4" maxlength="1000"></textarea>
            </div>

            <div>
                <label asp-for="TaskInput.Priority">Prioritet</label>
                <select asp-for="TaskInput.Priority">
                    <option value="1">Låg</option>
                    <option value="2">Medel</option>
                    <option value="3">Hög</option>
                </select>
            </div>

            <div>
                <label asp-for="TaskInput.EstimatedHours">
                    Uppskattad arbetsinsats (timmar)
                </label>
                <input asp-for="TaskInput.EstimatedHours" type="number" min="0" max="1000" step="0.5" />
            </div>

            <div>
                <label asp-for="TaskInput.Deadline">Deadline</label>
                <input asp-for="TaskInput.Deadline" type="date" />
            </div>

            <section class="create-task-checklist">
                <h3>Checklista</h3>

                <label for="newChecklistItem">Lägg till delmoment (frivilligt)</label>

                <div class="new-checklist-items">
                    <div class="new-checklist-row">
                        <input type="text" id="newChecklistItem" name="checklistItems" placeholder="Delmoment 1"
                               maxlength="100" />
                    </div>
                    @if (ViewData["PostedChecklistItems"] is List<string> postedItems)
                    {
                        @foreach (var postedItem in postedItems)
                        {
                            <div class="new-checklist-row">
                                <input type="text" name="checklistItems" value="@postedItem" maxlength="100" />
                                <button type="button" class="remove-new-checklist-item">Ta bort</button>
                            </div>
                        }
                    }
                </div>
                <button type="button" class="add-new-checklist-item">
                    + Lägg till delmoment
                </button>
            </section>

            <button type="submit">Skapa uppgift</button>
        </form>
    </section>
</main>

<script>
    const editCourseDialog = document.getElementById("editCourseDialog");

    document.getElementById("openEditCourseDialog").addEventListener("click", () => {
        editCourseDialog.showModal();
    });

    document.getElementById("closeEditCourseDialog").addEventListener("click", () => {
        editCourseDialog.close();
    });

    const deleteCourseDialog = document.getElementById("deleteCourseDialog");

    document.getElementById("openDeleteCourseDialog").addEventListener("click", () => {
        editCourseDialog.close();
        deleteCourseDialog.showModal();
    });

    document.getElementById("closeDeleteCourseDialog").addEventListener("click", () => {
        deleteCourseDialog.close();
        editCourseDialog.showModal();
    });

    // Open the selected task's details dialog.
    document.querySelectorAll(".task-details-button").forEach(button => {
        button.addEventListener("click", () => {
            const taskId = button.dataset.taskId;
            const dialog = document.getElementById(`taskDialog-${taskId}`);

            dialog.showModal();
        });
    });

    // Close the task details dialog.
    document.querySelectorAll(".close-task-dialog").forEach(button => {
        button.addEventListener("click", () => {
            button.closest("dialog").close();
        });
    });

    // Automatically save the task status when changed, without reloading the page.
    document.querySelectorAll(".task-status-select").forEach(select => {
        let savedStatus = select.value;

        select.addEventListener("change", async () => {
            const form = select.closest("form");
            const formData = new FormData(form);

            select.disabled = true;

            try {
                const response = await fetch(form.action, {
                    method: "POST",
                    body: formData
                });

                if (!response.ok) {
                    throw new Error("Failed to save status.");
                }

                savedStatus = select.value;
            } catch (error) {
                console.error(error);
                select.value = savedStatus;
                alert("Kunde inte spara statusen.");
            } finally {
                select.disabled = false;
            }
        });
    });

    // Save checklist changes and synchronize progress across the page.
    document.querySelectorAll(".checklist-checkbox").forEach(checkbox => {
        checkbox.addEventListener("change", async () => {
            const itemId = checkbox.dataset.itemId;
            const isCompleted = checkbox.checked;

            const matchingCheckboxes = document.querySelectorAll(
                `.checklist-checkbox[data-item-id="${itemId}"]`
            );

            matchingCheckboxes.forEach(item => {
                item.disabled = true;
            });

            try {
                const token = document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                ).value;

                const data = new FormData();
                data.append("itemId", itemId);
                data.append("isCompleted", isCompleted);
                data.append("__RequestVerificationToken", token);

                const response = await fetch(
                    `${window.location.pathname}?handler=UpdateChecklistItem`,
                    {
                        method: "POST",
                        body: data
                    }
                );

                if (!response.ok) {
                    throw new Error("Failed to update checklist item.");
                }

                // Synchronize matching checkboxes.
                matchingCheckboxes.forEach(item => {
                    item.checked = isCompleted;
                });

                // Keep incomplete items in their original order and completed items last.
                matchingCheckboxes.forEach(item => {
                    const list = item.closest("ul");

                    const sortedItems = [...list.children].sort((a, b) => {
                        const aCompleted = a.querySelector(".checklist-checkbox").checked;
                        const bCompleted = b.querySelector(".checklist-checkbox").checked;

                        if (aCompleted !== bCompleted) {
                            return Number(aCompleted) - Number(bCompleted);
                        }

                        return Number(a.dataset.order) - Number(b.dataset.order);
                    });

                    sortedItems.forEach(row => list.appendChild(row));
                });

                // Update progress in both task cards and dialogs.
                document.querySelectorAll(".task-card-checklist, dialog[id^='taskDialog-']")
                    .forEach(container => {
                        const checkboxes = container.querySelectorAll(".checklist-checkbox");

                        if (checkboxes.length === 0) return;

                        const completed = [...checkboxes].filter(item => item.checked).length;
                        const total = checkboxes.length;

                        const count = container.querySelector(".checklist-count");
                        const progress = container.querySelector(".checklist-progress");

                        if (count) count.textContent = `${completed}/${total} done`;
                        if (progress) progress.value = completed;
                    });

            } catch (error) {
                console.error(error);

                matchingCheckboxes.forEach(item => {
                    item.checked = !isCompleted;
                });

                alert("Kunde inte spara delmomentet.");
            } finally {
                matchingCheckboxes.forEach(item => {
                    item.disabled = false;
                });
            }
        });
    });

    // Open the task editor from the details dialog.
    document.querySelectorAll(".open-edit-task-dialog").forEach(button => {
        button.addEventListener("click", () => {
            const taskId = button.dataset.taskId;

            document.getElementById(`taskDialog-${taskId}`).close();
            document.getElementById(`editTaskDialog-${taskId}`).showModal();
        });
    });

    // Add new checklist items without submitting the form.
    document.querySelectorAll(".add-checklist-row").forEach(button => {
        button.addEventListener("click", () => {
            const container = button
                .closest(".edit-task-form")
                .querySelector(".edit-checklist-items");

            const empty = [...container.querySelectorAll('input[name="itemTitles"], input[name="newItemTitles"]')]
                .find(input => !input.value.trim());
            if (empty) {
                const form = button.closest("form");
                updateValidationSummary(form, { checklist: "Fyll i delmomentet innan du lägger till ett nytt." });
                empty.focus();
                return;
            }
            const row = document.createElement("div");
            row.className = "edit-checklist-row";

            row.innerHTML = `
            <input type="text" name="newItemTitles"
                   maxlength="100" aria-label="Nytt delmoment" />
            <button type="button" class="remove-checklist-row">
                Ta bort
            </button>
        `;

            container.appendChild(row);
        });
    });

    // Remove checklist rows without submitting the form.
    document.querySelectorAll(".edit-task-form").forEach(form => {
        form.addEventListener("click", event => {
            const removeButton = event.target.closest(".remove-checklist-row");

            if (removeButton) {
                const row = removeButton.closest(".edit-checklist-row");
                if (row) row.remove();
                else {
                    removeButton.nextElementSibling?.remove();
                    removeButton.remove();
                }
            }
        });
    });

    // Add and remove checklist fields. Show errors inline, never in a popup.
    const newChecklistContainer = document.querySelector(".new-checklist-items");
    const newChecklistError = document.querySelector('[data-error-for="checklistItems"]');
    const clearNewChecklistError = () => {
        if ([...newChecklistContainer.querySelectorAll('input[name="checklistItems"]')]
            .every(input => input.value.trim())) newChecklistError.textContent = "";
    };

    document.querySelector(".add-new-checklist-item").addEventListener("click", () => {
        const inputs = [...newChecklistContainer.querySelectorAll('input[name="checklistItems"]')];
        const empty = inputs.find(input => !input.value.trim());
        if (empty) {
            newChecklistError.textContent = "Fyll i delmomentet innan du lägger till ett nytt.";
            empty.focus();
            return;
        }
        newChecklistError.textContent = "";
        const row = document.createElement("div");
        row.className = "new-checklist-row";
        row.innerHTML = `<input type="text" name="checklistItems" placeholder="Nytt delmoment" maxlength="100" />
            <button type="button" class="remove-new-checklist-item">Ta bort</button>`;
        newChecklistContainer.appendChild(row);
        row.querySelector("input").focus();
    });
    newChecklistContainer.addEventListener("input", clearNewChecklistError);
    newChecklistContainer.addEventListener("click", event => {
        const button = event.target.closest(".remove-new-checklist-item");
        if (!button) return;
        button.closest(".new-checklist-row").remove();
        clearNewChecklistError();
    });

    // Close the task editor.
    document.querySelectorAll(".close-edit-task-dialog").forEach(button => {
        button.addEventListener("click", () => {
            button.closest("dialog").close();
        });
    });

    @if (ViewData.ModelState.ContainsKey("CourseName") &&
      ViewData.ModelState["CourseName"]!.Errors.Count > 0)
        {
            <text>
                    editCourseDialog.showModal();
            </text>
    }
    // Keep the create form in view if server validation rejects the POST.
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Keys.Any(k => k.StartsWith("TaskInput.") || k == "checklistItems"))
    {
        <text>
        document.querySelector(".create-task-form")?.scrollIntoView({ block: "start" });
        </text>
    }
    // Validate task forms before posting. Native POST remains unchanged.
    function validateTaskForm(form, edit) {
        const field = name => form.elements.namedItem(edit ? name : `TaskInput.${name.charAt(0).toUpperCase()}${name.slice(1)}`);
        const errors = {};
        const title = field("title")?.value.trim() ?? "";
        const description = field("description")?.value ?? "";
        const priority = field("priority")?.value ?? "";
        const hours = field("estimatedHours")?.value ?? "";
        const deadline = field("deadline")?.value ?? "";
        if (!title) errors.title = "Du måste ange ett namn på uppgiften.";
        else if (title.length > 100) errors.title = "Uppgiftens namn får innehålla högst 100 tecken.";
        if (description.length > 1000) errors.description = "Beskrivningen får innehålla högst 1000 tecken.";
        if (!["1", "2", "3"].includes(priority)) errors.priority = "Välj en giltig prioritet.";
        // An empty effort field is treated as zero (the model uses a non-nullable number).
        if (hours !== "" && (!Number.isFinite(Number(hours)) || Number(hours) < 0 || Number(hours) > 1000))
            errors.estimatedHours = "Arbetsinsatsen måste vara mellan 0 och 1000 timmar.";
        if (deadline) {
            const parsed = new Date(`${deadline}T00:00:00`);
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            if (!Number.isFinite(parsed.getTime())) errors.deadline = "Ange ett giltigt datum.";
            else if (parsed < today) errors.deadline = "Deadline får inte ligga bakåt i tiden.";
        }
        if (edit) {
            if ([...form.querySelectorAll('input[name="itemTitles"], input[name="newItemTitles"]')]
                .some(input => !input.value.trim() || input.value.trim().length > 100))
                errors.checklist = "Delmoment måste innehålla 1–100 tecken.";
        } else if ([...form.querySelectorAll('input[name="checklistItems"]')]
            .some(input => input.value.trim().length > 100)) {
            errors.checklistItems = "Delmoment får innehålla högst 100 tecken.";
        }
        updateValidationSummary(form, errors);
        return Object.keys(errors).length === 0;
    }

    function updateValidationSummary(form, errors) {
        const summary = form.querySelector(".validation-summary");
        if (!summary) return;
        const messages = [...new Set(Object.values(errors).filter(Boolean))];
        summary.hidden = messages.length === 0;
        summary.replaceChildren();
        if (messages.length) {
            const heading = document.createElement("strong");
            heading.textContent = "Kontrollera följande:";
            const list = document.createElement("ul");
            for (const message of messages) {
                const item = document.createElement("li");
                item.textContent = message;
                list.appendChild(item);
            }
            summary.append(heading, list);
            summary.style.color = "#b42318";
        }
    }

    document.querySelectorAll(".create-task-form, .edit-task-form").forEach(form => {
        const edit = form.classList.contains("edit-task-form");
        let attemptedSave = false;
        form.addEventListener("submit", event => {
            attemptedSave = true;
            if (!validateTaskForm(form, edit)) {
                event.preventDefault();
                form.querySelector(".validation-summary")?.scrollIntoView({ block: "nearest" });
            }
        });
        form.addEventListener("input", () => {
            if (attemptedSave) validateTaskForm(form, edit);
        });
        form.addEventListener("change", () => {
            if (attemptedSave) validateTaskForm(form, edit);
        });
    });

    // Custom confirmation dialog, matching the course deletion dialog.
    document.querySelectorAll(".open-delete-task-dialog").forEach(button => {
        button.addEventListener("click", () => {
            const taskId = button.dataset.taskId;
            document.getElementById(`taskDialog-${taskId}`)?.close();
            document.getElementById(`deleteTaskDialog-${taskId}`)?.showModal();
        });
    });
    document.querySelectorAll(".cancel-delete-task").forEach(button => {
        button.addEventListener("click", () => button.closest("dialog")?.close());
    });

    // Validate the course editor without browser popups.
    const courseForm = editCourseDialog.querySelector('form');
    courseForm.addEventListener("submit", event => {
        const name = courseForm.elements.namedItem("CourseName");
        const color = courseForm.elements.namedItem("CourseColor");
        const nameError = courseForm.querySelector('[data-valmsg-for="CourseName"]');
        const colorError = courseForm.querySelector('[data-valmsg-for="CourseColor"]');
        nameError.textContent = !name.value.trim() ? "Du måste ange ett kursnamn."
            : name.value.trim().length > 100 ? "Kursnamnet får innehålla högst 100 tecken." : "";
        colorError.textContent = /^#[0-9a-fA-F]{6}$/.test(color.value) ? "" : "Ogiltig färgkod.";
        if (nameError.textContent || colorError.textContent) event.preventDefault();
    });
    courseForm.addEventListener("input", () => {
        courseForm.querySelectorAll('[data-valmsg-for]').forEach(x => x.textContent = "");
    });

</script>