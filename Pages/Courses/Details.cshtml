@page "{id:int}"
@model StudyFlow.Pages.Courses.DetailsModel

@{
    ViewData["Title"] = Model.Course.Name;
}

<main class="course-details-page"
      data-course-name-error="@(ViewData.ModelState.ContainsKey("CourseName") && ViewData.ModelState["CourseName"]!.Errors.Count > 0 || ViewData.ModelState.ContainsKey("CourseColor") && ViewData.ModelState["CourseColor"]!.Errors.Count > 0)"
      data-task-input-error="@(!ViewData.ModelState.IsValid && ViewData.ModelState.Keys.Any(k => k.StartsWith("TaskInput.") || k == "checklistItems"))">

    <a asp-page="./Index" class="back-to-courses">
        <iconify-icon icon="lucide:arrow-left" aria-hidden="true"></iconify-icon>
        Back to my courses
    </a>

    <header class="course-details-header">
        <h1><span class="tape-heading">@Model.Course.Name</span></h1>

        <button type="button" id="openEditCourseDialog" class="add-course-btn edit-course-btn">
            <iconify-icon icon="lucide:pencil" aria-hidden="true"></iconify-icon>
            Edit course
        </button>
    </header>

    
    @* Course editing dialog *@
    <dialog id="editCourseDialog" class="course-dialog" aria-labelledby="editCourseDialogTitle">

        <div class="course-dialog-content">
            <div class="edit-course-dialog-header">
                <h2 id="editCourseDialogTitle">Edit course</h2>

                <button type="button" id="openDeleteCourseDialog" class="delete-course-btn">
                    <iconify-icon icon="lucide:trash-2" aria-hidden="true"></iconify-icon>
                    Delete course
                </button>
            </div>

            <form method="post" asp-page-handler="Edit" novalidate>
                <div>
                    <label asp-for="CourseName">Course name</label>
                    <input asp-for="CourseName" placeholder="Enter course name" autocomplete="off" maxlength="100" />
                    <span asp-validation-for="CourseName" class="text-danger"></span>
                </div>

                <fieldset class="course-color-picker">
                    <legend>Course color</legend>

                    @foreach (var color in Model.AvailableColors)
                    {
                        <label class="course-color-option" style="--swatch-color: @color">
                            <input type="radio" asp-for="CourseColor" id="edit-course-color-@color.TrimStart('#')"
                                   value="@color" />

                            <span class="course-color-swatch">
                                <iconify-icon icon="lucide:check" aria-hidden="true"></iconify-icon>
                            </span>

                            <span class="visually-hidden">Course color @color</span>
                        </label>
                    }

                    <span asp-validation-for="CourseColor" class="text-danger"></span>
                </fieldset>

                <div class="dialog-actions">
                    <button type="button" class="cancel-btn" id="closeEditCourseDialog">
                        <iconify-icon icon="lucide:x" aria-hidden="true"></iconify-icon>
                        Cancel
                    </button>

                    <button type="submit" class="add-course-btn">
                        <span class="add-course-icon">
                            <iconify-icon icon="lucide:book-open"></iconify-icon>
                            <iconify-icon icon="lucide:check"></iconify-icon>
                        </span>
                        Save changes
                    </button>
                </div>
            </form>
        </div>
    </dialog>
    
    @* Course deletion confirmation *@
    <dialog id="deleteCourseDialog" class="course-dialog" aria-labelledby="deleteCourseDialogTitle"
            aria-describedby="deleteCourseDialogDescription">

        <div class="course-dialog-content">
            <h2 id="deleteCourseDialogTitle">Delete course?</h2>

            <p id="deleteCourseDialogDescription">
                Are you sure you want to delete
                <strong>@Model.Course.Name</strong>?
                All tasks and checklists belonging to this course
                will also be permanently deleted.
            </p>

            <form method="post" asp-page-handler="Delete">
                <div class="dialog-actions">
                    <button type="button" class="cancel-btn" id="closeDeleteCourseDialog">
                        <iconify-icon icon="lucide:x" aria-hidden="true"></iconify-icon>
                        Cancel
                    </button>

                    <button type="submit" class="delete-course-confirm-btn">
                        <iconify-icon icon="lucide:trash-2" aria-hidden="true"></iconify-icon>
                        Delete course
                    </button>
                </div>
            </form>
        </div>
    </dialog>


    @* Reuse the dashboard's book layout *@
    <div class="dashboard-book">

        @* LEFT PAGE: Course tasks *@
        <section class="dashboard-book-page" aria-labelledby="focus-heading">

            <h2 id="focus-heading">
                @(Model.TodaysFocus?.Task.Status == "InProgress"
                    ? "Work in progress"
                    : "Today's focus")
            </h2>

            @if (Model.TodaysFocus != null)
            {
                <ul>
                    <partial name="_TaskCard" model="Model.TodaysFocus.Task" />
                </ul>
            }
            else
            {
                <p>No tasks to focus on right now.</p>
            }

            <section aria-labelledby="next-up-heading">
                <h2 id="next-up-heading">Next up</h2>

                @{
                    var otherTasks = Model.Tasks
                        .Where(task =>
                            task.Status != "Completed" &&
                            task.Id != Model.TodaysFocus?.Task.Id)
                        .ToList();
                }

                @if (otherTasks.Any())
                {
                    <ul class="next-up-task-list">
                        @foreach (var task in otherTasks)
                        {
                            <partial name="_TaskCardCompact" model="task" />
                        }
                    </ul>
                }
                else
                {
                    <p>No upcoming tasks to show.</p>
                }
            </section>

        </section>

        @* RIGHT PAGE: Create a task *@
        <section class="dashboard-book-page" aria-labelledby="add-task-heading">

            <h2 id="add-task-heading">Add new task</h2>

            <partial name="_CreateTaskForm" model="Model.TaskInput" />

        </section>

    </div>

    @* Keep all existing task dialogs *@
    @foreach (var task in Model.Tasks)
    {
        <partial name="_TaskDetailsDialog" model="task" />
    }

    @foreach (var task in Model.Tasks)
    {
        <partial name="_DeleteTaskDialog" model="task" />
    }

    @foreach (var task in Model.Tasks)
    {
        <partial name="_EditTaskDialog" model="task" />
    }

</main>

@section Scripts {
    <script src="~/js/task-form-validation.js" asp-append-version="true"></script>
    <script src="~/js/course-details.js" asp-append-version="true"></script>
}
