@page "{id:int}"
@model StudyFlow.Pages.Courses.DetailsModel

@{
    ViewData["Title"] = Model.Course.Name;
}

<main
    data-course-name-error="@(ViewData.ModelState.ContainsKey("CourseName") && ViewData.ModelState["CourseName"]!.Errors.Count > 0)"
    data-task-input-error="@(!ViewData.ModelState.IsValid && ViewData.ModelState.Keys.Any(k => k.StartsWith("TaskInput.") || k == "checklistItems"))">
    <a asp-page="./Index">← Tillbaka till mina kurser</a>

    <header>
        <h1>@Model.Course.Name</h1>
    </header>

    <button type="button" id="openEditCourseDialog">
        Redigera kurs
    </button>

    <dialog id="editCourseDialog" aria-labelledby="editCourseDialogTitle">
        <h2 id="editCourseDialogTitle">Redigera kurs</h2>

        <form method="post" asp-page-handler="Edit" novalidate>
            <div>
                <label asp-for="CourseName">Kursnamn</label>
                <input asp-for="CourseName" maxlength="100" />
                <span asp-validation-for="CourseName" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="CourseColor">Kursfärg</label>
                <input asp-for="CourseColor" type="color" />
                <span asp-validation-for="CourseColor" class="text-danger"></span>
            </div>

            <button type="submit">Spara ändringar</button>
            <button type="button" id="closeEditCourseDialog">Avbryt</button>
            <button type="button" id="openDeleteCourseDialog">Ta bort kurs</button>
        </form>
    </dialog>

    <dialog id="deleteCourseDialog" aria-labelledby="deleteCourseDialogTitle"
            aria-describedby="deleteCourseDialogDescription">

        <h2 id="deleteCourseDialogTitle">Ta bort kurs?</h2>

        <p id="deleteCourseDialogDescription">
            Är du säker på att du vill ta bort kursen
            <strong>@Model.Course.Name</strong>?
            Alla uppgifter och checklistor som tillhör kursen
            kommer också att raderas permanent.
        </p>

        <form method="post" asp-page-handler="Delete">
            <button type="button" id="closeDeleteCourseDialog">
                Avbryt
            </button>

            <button type="submit">
                Ja, ta bort kurs
            </button>
        </form>
    </dialog>

    <section aria-labelledby="tasks-heading">
        <h2 id="tasks-heading">Uppgifter</h2>

        <h3>Today's focus</h3>

        @if (Model.TodaysFocus != null)
        {
            <ul>
                <partial name="_TaskCard" model="Model.TodaysFocus.Task" />
            </ul>
        }
        else
        {
            <p>Inga uppgifter att prioritera just nu.</p>
        }

        <h3>Övriga uppgifter</h3>

        @{
            var otherTasks = Model.Tasks
                .Where(task => task.Id != Model.TodaysFocus?.Task.Id)
                .ToList();
        }

        @if (otherTasks.Any())
        {
            <ul>
                @foreach (var task in otherTasks)
                {
                    @* Render a reusable task card for each task. *@
                    <partial name="_TaskCard" model="task" />
                }
            </ul>
        }
        else
        {
            <p>Inga övriga uppgifter att visa.</p>
        }
    </section>

    @foreach (var task in Model.Tasks)
    {
        <partial name="_TaskDetailsDialog" model="task" />
    }

    @foreach (var task in Model.Tasks)
    {
        <partial name="_DeleteTaskDialog" model="task" />
    }

    @foreach (var task in Model.Tasks)
    {
        @* Render the task editing dialog. *@
        <partial name="_EditTaskDialog" model="task" />
    }

    <section aria-labelledby="add-task-heading">
        <h2 id="add-task-heading">Lägg till uppgift</h2>

        <partial name="_CreateTaskForm" model="Model.TaskInput" />
    </section>
</main>

@section Scripts {
    <script src="~/js/task-form-validation.js" asp-append-version="true"></script>
    <script src="~/js/course-details.js" asp-append-version="true"></script>
}
