@page
@model StudyFlow.Pages.Courses.EditModel

@{
    ViewData["Title"] = "Redigera kurs";
}

<h1>Redigera kurs</h1>

<form method="post">
    <input type="hidden" name="id" value="@Model.CourseId" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger"
         role="alert"></div>

    <div>
        <label asp-for="CourseName">Kursnamn</label>
        <input asp-for="CourseName"
               type="text"
               autocomplete="off"
               aria-describedby="courseNameError" />
        <span asp-validation-for="CourseName"
              id="courseNameError"
              class="text-danger"></span>
    </div>

    <div>
        <label asp-for="CourseColor">Kursfärg</label>
        <input asp-for="CourseColor"
               type="color"
               aria-describedby="courseColorHelp courseColorError" />
        <p id="courseColorHelp">
            Välj en färg som representerar kursen.
        </p>
        <span asp-validation-for="CourseColor"
              id="courseColorError"
              class="text-danger"></span>
    </div>

    <div>
        <button type="submit">Spara ändringar</button>
        <a asp-page="./Index">Avbryt</a>
    </div>
</form>