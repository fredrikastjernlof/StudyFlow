@page
@model StudyFlow.Pages.Courses.IndexModel

@{
    ViewData["Title"] = "My Courses";
}

<main class="courses-page">
    <header class="courses-page-header">
        <h1><span class="tape-heading">My courses</span></h1>

        <button type="button" class="add-course-btn" id="openCourseDialog">
            <span class="add-course-icon">
                <iconify-icon icon="lucide:book-open"></iconify-icon>
                <iconify-icon icon="lucide:plus"></iconify-icon>
            </span>
            Add new course
        </button>
    </header>

    <section class="bulletin-board" aria-label="My courses">
        @if (Model.Courses.Count == 0)
        {
            <p class="empty-state-note empty-state-note--pinned">
                You haven't added any courses yet.
            </p>
        }
        else
        {
            <ul class="course-grid">
                @foreach (var course in Model.Courses)
                {
                    <partial name="_CourseCard" model="course" />
                }
            </ul>
        }
    </section>
</main>

<dialog class="course-dialog" id="courseDialog" aria-labelledby="courseDialogTitle"
        data-validation-error="@(!ViewData.ModelState.IsValid)">

    <div class="course-dialog-content">

        <h2 id="courseDialogTitle">Add New Course</h2>

        <form method="post">
            <div>
                <label asp-for="CourseName">Course name</label>
                <input asp-for="CourseName" placeholder="Enter course name" autocomplete="off" />
                <span asp-validation-for="CourseName" class="text-danger"></span>
            </div>

            <fieldset class="course-color-picker">
                <legend>Course color</legend>

                @foreach (var color in Model.AvailableColors)
                {
                    <label class="course-color-option" style="--swatch-color: @color">

                        <input type="radio" asp-for="CourseColor" id="course-color-@color.TrimStart('#')" value="@color" />

                        <span class="course-color-swatch">
                            <iconify-icon icon="lucide:check" aria-hidden="true"></iconify-icon>
                        </span>

                        <span class="visually-hidden">Course color @color</span>
                    </label>
                }

                <span asp-validation-for="CourseColor" class="text-danger"></span>
            </fieldset>

            <div class="dialog-actions">
                <button type="button" class="cancel-btn" id="closeCourseDialog">
                    <iconify-icon icon="lucide:x" aria-hidden="true"></iconify-icon>
                    Cancel
                </button>

                <button class="add-course-btn" type="submit">
                    <span class="add-course-icon">
                        <iconify-icon icon="lucide:book-open"></iconify-icon>
                        <iconify-icon icon="lucide:plus"></iconify-icon>
                    </span>
                    Add course
                </button>
            </div>
        </form>

    </div>
</dialog>

<script src="~/js/courses.js" asp-append-version="true"></script>