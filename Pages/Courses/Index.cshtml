@page
@model StudyFlow.Pages.Courses.IndexModel

@{
    ViewData["Title"] = "Mina kurser";
}

<h1>Mina kurser</h1>

<button type="button" id="openCourseDialog">
    + Lägg till kurs
</button>

<dialog id="courseDialog"
        aria-labelledby="courseDialogTitle"
        data-validation-error="@(!ViewData.ModelState.IsValid)">
    <h2 id="courseDialogTitle">Lägg till kurs</h2>

    <form method="post">
        <div>
            <label asp-for="CourseName">Kursnamn</label>
            <input asp-for="CourseName" placeholder="Ange kursnamn" />
            <span asp-validation-for="CourseName" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="CourseColor">Kursfärg</label>
            <input asp-for="CourseColor" type="color" />
            <span asp-validation-for="CourseColor" class="text-danger"></span>
        </div>

        <button type="submit">Lägg till kurs</button>
    </form>

    <button type="button" id="closeCourseDialog">
        Avbryt
    </button>
</dialog>

<script src="~/js/courses.js" asp-append-version="true"></script>

@if (Model.Courses.Count == 0)
{
    <p>Du har inte lagt till några kurser ännu.</p>
}
else
{
    <ul class="course-grid">
        @foreach (var course in Model.Courses)
        {
            @* Render a reusable course card. *@
            <partial name="_CourseCard" model="course" />
        }
    </ul>
}