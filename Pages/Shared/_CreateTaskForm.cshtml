@model StudyFlow.ViewModels.StudyTaskInputModel

@{
    var showCourseSelect = ViewData["ShowCourseSelect"] is true;
    var courses = ViewData["AvailableCourses"] as IEnumerable<StudyFlow.Models.Course>;
    var selectedCourseId = ViewData["SelectedCourseId"]?.ToString();
}

<form method="post" asp-page-handler="CreateTask" class="create-task-form" novalidate>

    @* Display server-side validation errors. *@
    @if (!ViewData.ModelState.IsValid &&
        ViewData.ModelState.Keys.Any(k =>
            k.StartsWith("TaskInput.") || k == "checklistItems" || k == "CourseId"))
    {
        <div class="validation-summary text-danger" role="alert">
            <strong>Please check the following:</strong>
            <ul>
                @foreach (var error in ViewData.ModelState
                    .Where(kvp => kvp.Key.StartsWith("TaskInput.") ||
                                  kvp.Key == "checklistItems" ||
                                  kvp.Key == "CourseId")
                    .SelectMany(kvp => kvp.Value!.Errors)
                    .Select(e => e.ErrorMessage)
                    .Distinct())
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }
    else
    {
        <div class="validation-summary text-danger" role="alert" aria-live="polite" hidden></div>
    }

    
    <div class="task-form-top-row">
        <div class="task-form-field">
            <label for="TaskInput_Title">Task name</label>
            <input id="TaskInput_Title" name="TaskInput.Title" value="@Model.Title" maxlength="100"
                   placeholder="Enter task name" autocomplete="off" />
        </div>

        @* Course selection is only displayed when creating a task outside a course. *@
    
        @if (showCourseSelect)
        {
            <div class="task-form-field">
                <label for="CourseId">Course (optional)</label>
                <select id="CourseId" name="CourseId">
                    <option value="">No course</option>

                    @if (courses != null)
                    {
                        @foreach (var course in courses)
                        {
                            if (selectedCourseId == course.Id.ToString())
                            {
                                <option value="@course.Id" selected>@course.Name</option>
                            }
                            else
                            {
                                <option value="@course.Id">@course.Name</option>
                            }
                        }
                    }
                </select>
            </div>
        }
    </div>

    <div class="task-form-field">
        <label for="TaskInput_Description">Description</label>
        <textarea id="TaskInput_Description" name="TaskInput.Description" rows="4" maxlength="1000"
                  placeholder="Describe your task...">@Model.Description</textarea>
    </div>

    @* Priority and estimated hours share a row on larger screens. *@
    <div class="task-form-row">
        <div class="task-form-field">
            <label for="TaskInput_Priority">Priority</label>
            <select id="TaskInput_Priority" name="TaskInput.Priority">
                @foreach (var option in new[] { (1, "Low"), (2, "Medium"), (3, "High") })
                {
                    if (Model.Priority == option.Item1)
                    {
                        <option value="@option.Item1" selected>@option.Item2</option>
                    }
                    else
                    {
                        <option value="@option.Item1">@option.Item2</option>
                    }
                }
            </select>
        </div>

        <div class="task-form-field">
            <label for="TaskInput_EstimatedHours">Estimated hours</label>
            <input id="TaskInput_EstimatedHours" name="TaskInput.EstimatedHours" type="number" min="0" max="1000"
                   step="0.5" value="@Model.EstimatedHours.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
        </div>
    </div>

    <div class="task-form-field">
        <label for="TaskInput_Deadline">Deadline</label>
        <input id="TaskInput_Deadline" name="TaskInput.Deadline" type="date"
               value="@Model.Deadline?.ToString("yyyy-MM-dd")" />
    </div>

    @* Optional checklist items can be added or removed dynamically. *@
    <section class="create-task-checklist">

        <h3>My checklist</h3>

        <label for="newChecklistItem">Add checklist items (optional)</label>

        <div class="new-checklist-items">
            <div class="new-checklist-row">
                <input type="text" id="newChecklistItem" name="checklistItems" placeholder="Checklist item 1"
                       maxlength="100" autocomplete="off" />
            </div>

            @if (ViewData["PostedChecklistItems"] is List<string> postedItems)
            {
                @foreach (var postedItem in postedItems)
                {
                    <div class="new-checklist-row">
                        <input type="text" name="checklistItems" value="@postedItem" maxlength="100" />

                        <button type="button" class="remove-new-checklist-item">
                            Remove
                        </button>
                    </div>
                }
            }
        </div>

        <p data-error-for="checklistItems" class="text-danger" role="alert"></p>

        <button type="button" class="add-new-checklist-item">
            <iconify-icon icon="lucide:plus" aria-hidden="true"></iconify-icon>
            Add checklist item
        </button>
    </section>

    <button type="submit" class="create-task-submit">
        <iconify-icon icon="lucide:plus" aria-hidden="true"></iconify-icon>
        Add task
    </button>
</form>
