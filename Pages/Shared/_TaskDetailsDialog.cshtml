@* Display task details and checklist progress. *@
@model StudyFlow.Models.StudyTask

@{
    var task = Model;
    var totalItems = task.ChecklistItems.Count;
    var completedItems = task.ChecklistItems.Count(item => item.IsCompleted);
    var priorityLabel = task.Priority == 3 ? "High" :
                        task.Priority == 2 ? "Medium" : "Low";
}

<dialog id="taskDialog-@task.Id" class="task-details-dialog course-dialog"
        style="--task-dialog-color: @(task.Course?.Color ?? "#C8E8D5")" aria-labelledby="taskHeading-@task.Id">

    <div class="course-dialog-content task-dialog-content">
        <button type="button" class="close-task-dialog task-dialog-close" aria-label="Close dialog">
            <iconify-icon icon="lucide:x" aria-hidden="true"></iconify-icon>
        </button>

        <h2 id="taskHeading-@task.Id">@task.Title</h2>

        <p class="task-dialog-course">@task.Course?.Name</p>

        <div class="task-dialog-meta">
            <form method="post" asp-page-handler="UpdateTaskStatus" class="task-status-form">
                <input type="hidden" name="taskId" value="@task.Id" />
                <div class="validation-summary text-danger" role="alert" aria-live="polite" hidden></div>

                <div>
                    <label for="taskStatus-@task.Id">Status</label>
                    <select id="taskStatus-@task.Id" name="status" class="task-status-select">
                        <option value="NotStarted" selected="@(task.Status == "NotStarted")">Not started</option>
                        <option value="InProgress" selected="@(task.Status == "InProgress")">In progress</option>
                        <option value="Completed" selected="@(task.Status == "Completed")">Completed</option>
                    </select>
                </div>
            </form>

            <span class="task-dialog-priority">@priorityLabel priority</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(task.Description))
        {
            <p class="task-dialog-description">@task.Description</p>
        }

        <p class="task-dialog-hours">Estimated effort: @task.EstimatedHours hours</p>

        @if (task.Deadline.HasValue)
        {
            <p class="task-dialog-deadline">
                <iconify-icon icon="lucide:calendar-days" aria-hidden="true"></iconify-icon>
                Deadline: @task.Deadline.Value.ToString("yyyy-MM-dd")
            </p>
        }

        @* Hand-drawn divider between task details and checklist. *@
        <svg class="task-card-divider" viewBox="0 0 300 14" preserveAspectRatio="none" aria-hidden="true">
            <path d="M3 9 Q150 1 297 9" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" />
        </svg>

        <section class="task-dialog-checklist" aria-labelledby="checklistHeading-@task.Id">
            <h3 id="checklistHeading-@task.Id">My Checklist</h3>

            @if (totalItems > 0)
            {
                <ul>
                    @foreach (var item in task.ChecklistItems.OrderBy(i => i.IsCompleted).ThenBy(i => i.Id))
                    {
                        <li data-order="@item.Id">
                            <label>
                                <input type="checkbox" class="checklist-checkbox" data-item-id="@item.Id"
                                       checked="@item.IsCompleted" />
                                @item.Title
                            </label>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p>No checklist items added yet.</p>
            }
        </section>

        <section class="task-dialog-progress" aria-label="Checklist progress">
            <div class="task-dialog-progress-heading">
                <strong>Making progress!</strong>
                <span class="checklist-count">@completedItems/@totalItems done</span>
            </div>

            <progress class="checklist-progress" value="@completedItems" max="@(totalItems > 0 ? totalItems : 1)"
                      aria-label="Completed checklist items">
            </progress>
        </section>

        <div class="task-dialog-actions">
            <button type="button" class="open-delete-task-dialog" data-task-id="@task.Id">
                <iconify-icon icon="lucide:trash-2" aria-hidden="true"></iconify-icon>
                Delete
            </button>

            <button type="button" class="open-edit-task-dialog" data-task-id="@task.Id">
                <iconify-icon icon="lucide:settings-2" aria-hidden="true"></iconify-icon>
                Edit task
            </button>
        </div>
    </div>
</dialog>
