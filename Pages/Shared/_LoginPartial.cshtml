@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Page("/Index", new { area = "" })"
                  method="post">

                <button type="submit" class="nav-link btn btn-link">
                    <iconify-icon icon="lucide:log-out" aria-hidden="true"></iconify-icon>
                    Log out
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link"
               asp-area="Identity"
               asp-page="/Account/Login">
               <iconify-icon icon="lucide:log-in" aria-hidden="true"></iconify-icon>
                Log in
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link"
               asp-area="Identity"
               asp-page="/Account/Register">
               <iconify-icon icon="lucide:user-plus" aria-hidden="true"></iconify-icon>
                Register
            </a>
        </li>
    }
</ul>