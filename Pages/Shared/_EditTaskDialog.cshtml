@* Receive the task to edit. *@
@model StudyFlow.Models.StudyTask

@{
    var task = Model;
}

<dialog id="editTaskDialog-@task.Id" class="course-dialog edit-task-dialog"
        style="--task-dialog-color: @(task.Course?.Color ?? "#D6CBFC")" aria-labelledby="editTaskHeading-@task.Id">

    <div class="course-dialog-content edit-task-dialog-content">

        <button type="button" class="close-edit-task-dialog edit-task-dialog-close" aria-label="Close dialog">
            <iconify-icon icon="lucide:x" aria-hidden="true"></iconify-icon>
        </button>

        <h2 id="editTaskHeading-@task.Id">Edit task</h2>

        @* Form for editing an existing task. *@
        <form method="post" asp-page-handler="EditTask" class="edit-task-form create-task-form" novalidate>

            <input type="hidden" name="taskId" value="@task.Id" />

            @* Displays validation errors handled by JavaScript. *@
            <div class="validation-summary text-danger" role="alert" aria-live="polite" hidden></div>

            <div class="task-form-field">
                <label for="editTitle-@task.Id">Task name</label>
                <input id="editTitle-@task.Id" name="title" value="@task.Title" maxlength="100" />
            </div>

            <div class="task-form-field">
                <label for="editDescription-@task.Id">Description</label>
                <textarea id="editDescription-@task.Id" name="description" rows="4"
                          maxlength="1000">@task.Description</textarea>
            </div>

            <div class="task-form-field">
                <label for="editDeadline-@task.Id">Deadline</label>
                <input id="editDeadline-@task.Id" name="deadline" type="date"
                       value="@(task.Deadline?.ToString("yyyy-MM-dd"))" />
            </div>

            @* Priority and estimated hours share a row on larger screens. *@
            <div class="task-form-row">
                <div class="task-form-field">
                    <label for="editPriority-@task.Id">Priority</label>
                    <select id="editPriority-@task.Id" name="priority">
                        <option value="1" selected="@(task.Priority == 1)">Low</option>
                        <option value="2" selected="@(task.Priority == 2)">Medium</option>
                        <option value="3" selected="@(task.Priority == 3)">High</option>
                    </select>
                </div>

                <div class="task-form-field">
                    <label for="editHours-@task.Id">Estimated hours</label>
                    <input id="editHours-@task.Id" name="estimatedHours" type="number" min="0" max="1000" step="0.5"
                           value="@task.EstimatedHours.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                </div>
            </div>

            <section class="create-task-checklist edit-task-checklist">
                <h3>Edit checklist</h3>

                <div class="edit-checklist-items">

                    @* Render existing checklist items for editing. *@
                    @foreach (var item in task.ChecklistItems.OrderBy(i => i.Id))
                    {
                        <div class="edit-checklist-row">
                            <input type="hidden" name="itemIds" value="@item.Id" />

                            <input type="text" name="itemTitles" value="@item.Title" maxlength="100"
                                   aria-label="Checklist item" />

                            <button type="button" class="remove-checklist-row">
                                Remove
                            </button>
                        </div>
                    }
                </div>

                <button type="button" class="add-checklist-row add-new-checklist-item">
                    <iconify-icon icon="lucide:plus" aria-hidden="true"></iconify-icon>
                    Add checklist item
                </button>
            </section>

            <div class="edit-task-actions">
                <button type="button" class="close-edit-task-dialog cancel-edit-task-btn">
                    Cancel
                </button>

                <button type="submit" class="save-edit-task-btn">
                    Save changes
                </button>
            </div>
        </form>
    </div>
</dialog>
