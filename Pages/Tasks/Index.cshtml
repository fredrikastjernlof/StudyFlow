
@page
@model StudyFlow.Pages.Tasks.IndexModel

@{
    ViewData["Title"] = "My tasks";

    var inProgress = Model.Tasks
        .Where(task => task.Status == "InProgress"
            && task.Id != Model.TodaysFocus?.Task.Id)
        .ToList();

    var comingUp = Model.Tasks
        .Where(task => task.Status == "NotStarted"
            && task.Id != Model.TodaysFocus?.Task.Id)
        .ToList();

    var completed = Model.Tasks
        .Where(t => t.Status == "Completed")
        .ToList();
}

<h1><span class="tape-heading">My tasks</span></h1>

<button type="button" id="open-create-task-dialog">
    + Add task
</button>

<dialog id="create-task-dialog" aria-labelledby="create-task-heading"
        data-open-on-load="@Model.OpenCreateDialog.ToString().ToLowerInvariant()">

    <div class="create-task-dialog-header">
        <h2 id="create-task-heading">Add task</h2>

        <button type="button" id="close-create-task-dialog">
            Close
        </button>
    </div>

    <partial name="_CreateTaskForm" model="Model.TaskInput" view-data="ViewData" />
</dialog>

<div class="tasks-book">

    <section class="tasks-book-page">
        <h2>Today's focus</h2>

        @if (Model.TodaysFocus != null)
        {
            <ul>
                <partial name="_TaskCard" model="Model.TodaysFocus.Task" />
            </ul>
        }
        else
        {
            <p>No tasks to prioritize right now.</p>
        }

        <h2>Work in progress</h2>

        @if (inProgress.Any())
        {
            <ul>
                @foreach (var task in inProgress)
                {
                    <partial name="_TaskCard" model="task" />
                }
            </ul>
        }
        else
        {
            <p>No tasks in progress.</p>
        }
    </section>

    <section class="tasks-book-page">
        <h2>Coming up</h2>

        @if (comingUp.Any())
        {
            <ul>
                @foreach (var task in comingUp)
                {
                    <partial name="_TaskCard" model="task" />
                }
            </ul>
        }
        else
        {
            <p>No upcoming tasks.</p>
        }

        <h2>Completed</h2>

        @if (completed.Any())
        {
            <ul>
                @foreach (var task in completed)
                {
                    <partial name="_TaskCard" model="task" />
                }
            </ul>
        }
        else
        {
            <p>No completed tasks.</p>
        }
    </section>

</div>

@foreach (var task in Model.Tasks)
{
    <partial name="_TaskDetailsDialog" model="task" />
    <partial name="_EditTaskDialog" model="task" />
    <partial name="_DeleteTaskDialog" model="task" />
}

@section Scripts {
    <script src="~/js/task-form-validation.js" asp-append-version="true"></script>
    <script src="~/js/tasks.js" asp-append-version="true"></script>
}
