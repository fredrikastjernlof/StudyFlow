
@page
@model StudyFlow.Pages.Tasks.IndexModel

@{
    ViewData["Title"] = "My tasks";

    var inProgress = Model.Tasks
        .Where(task => task.Status == "InProgress"
            && task.Id != Model.TodaysFocus?.Task.Id)
        .ToList();

    var comingUp = Model.Tasks
        .Where(task => task.Status == "NotStarted"
            && task.Id != Model.TodaysFocus?.Task.Id)
        .ToList();

    var completed = Model.Tasks
        .Where(task => task.Status == "Completed")
        .ToList();
}

<div class="tasks-page">
    <header class="tasks-page-header">
        <h1>
            <span class="tape-heading">My tasks</span>
        </h1>

        <button type="button"
                id="open-create-task-dialog"
                class="add-task-btn">
            <span class="add-task-icon" aria-hidden="true">
                <iconify-icon icon="lucide:sticky-note-plus"></iconify-icon>
            </span>
            Add task
        </button>
    </header>

    @* Create task dialog. *@
    <dialog id="create-task-dialog"
            class="create-task-dialog"
            aria-labelledby="create-task-heading"
            data-open-on-load="@Model.OpenCreateDialog.ToString().ToLowerInvariant()">

        <div class="course-dialog-content">

            <div class="create-task-dialog-header">
                <h2 id="create-task-heading">Add task</h2>

                <button type="button"
                        id="close-create-task-dialog"
                        class="task-dialog-close"
                        aria-label="Close dialog">
                    <iconify-icon icon="lucide:x" aria-hidden="true"></iconify-icon>
                </button>
            </div>

            <partial name="_CreateTaskForm"
                     model="Model.TaskInput"
                     view-data="ViewData" />

        </div>
    </dialog>

    @* Bulletin board with two columns on desktop. *@
    <div class="bulletin-board tasks-board">

        @* Left column. *@
        <div class="tasks-board-column">

            <section class="tasks-board-section todays-focus-section">
                <h2 class="board-note-heading">
                    Today's focus
                </h2>

                @if (Model.TodaysFocus != null)
                {
                    <ul class="board-task-list focus-task-list">
                        <partial name="_TaskCard"
                                 model="Model.TodaysFocus.Task" />
                    </ul>
                }
                else
                {
                    <p class="board-empty-message">
                        No tasks to prioritize right now.
                    </p>
                }
            </section>

            <section class="tasks-board-section in-progress-section">
                <h2 class="board-note-heading">
                    Work in progress
                </h2>

                @if (inProgress.Any())
                {
                    <ul class="board-task-list">
                        @foreach (var task in inProgress)
                        {
                            <partial name="_TaskCardCompact" model="task" />
                        }
                    </ul>
                }
                else
                {
                    <p class="board-empty-message">
                        No tasks in progress.
                    </p>
                }
            </section>

        </div>

        @* Right column. *@
        <div class="tasks-board-column">

            <section class="tasks-board-section coming-up-section">
                <h2 class="board-note-heading">
                    Coming up
                </h2>

                @if (comingUp.Any())
                {
                    <ul class="board-task-list">
                        @foreach (var task in comingUp)
                        {
                            <partial name="_TaskCardCompact" model="task" />
                        }
                    </ul>
                }
                else
                {
                    <p class="board-empty-message">
                        No upcoming tasks.
                    </p>
                }
            </section>

            <section class="tasks-board-section completed-section">
                <h2 class="board-note-heading">
                    Completed
                </h2>

                @if (completed.Any())
                {
                    <ul class="board-task-list">
                        @foreach (var task in completed)
                        {
                            <partial name="_TaskCardCompact" model="task" />
                        }
                    </ul>
                }
                else
                {
                    <p class="board-empty-message">
                        No completed tasks.
                    </p>
                }
            </section>

        </div>
    </div>
</div>

@foreach (var task in Model.Tasks)
{
    <partial name="_TaskDetailsDialog" model="task" />
    <partial name="_EditTaskDialog" model="task" />
    <partial name="_DeleteTaskDialog" model="task" />
}

@section Scripts {
    <script src="~/js/task-form-validation.js"
            asp-append-version="true"></script>
    <script src="~/js/tasks.js"
            asp-append-version="true"></script>
}
